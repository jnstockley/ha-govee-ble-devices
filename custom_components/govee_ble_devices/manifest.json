{
  "domain": "govee_ble_devices",
  "name": "Govee BLE Devices",
  "bluetooth": [
    {"local_name": "Govee*", "connectable": true},
    {"local_name": "GV5179*", "connectable": true},
    {"local_name": "GVH5179*", "connectable": true},
    {"local_name": "GVH7102*", "connectable": true},
    {"local_name": "GVH7126*", "connectable": true},
    {"local_name": "H5179*", "connectable": true},
    {"local_name": "H7102*", "connectable": true},
    {"local_name": "H7126*", "connectable": true}
  ],
  "codeowners": ["@jnstockley"],
  "config_flow": true,
  "dependencies": ["bluetooth", "bluetooth_adapters"],
  "documentation": "https://github.com/jnstockley/ha-govee-ble-devices",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/jnstockley/ha-govee-ble-devices/issues",
  "requirements": ["govee-ble-client==1.0.0b4"],
  "version": "1.0.0b4"
}
